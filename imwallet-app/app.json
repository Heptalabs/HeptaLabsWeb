{
  "expo": {
    "name": "IMWallet",
    "slug": "imwallet-app",
    "version": "0.1.0",
    "scheme": "imwallet",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.imwallet.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "QR 스캔을 위해 카메라 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "이미지 첨부를 위해 사진 권한이 필요합니다.",
        "NSFaceIDUsageDescription": "지갑 잠금 해제를 위해 Face ID 권한이 필요합니다."
      }
    },
    "android": {
      "package": "app.imwallet.mobile",
      "versionCode": 16,
      "permissions": [
        "CAMERA",
        "INTERNET",
        "USE_BIOMETRIC",
        "VIBRATE",
        "READ_MEDIA_IMAGES"
      ],
      "blockedPermissions": [
        "RECORD_AUDIO",
        "SYSTEM_ALERT_WINDOW",
        "USE_FINGERPRINT",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "QR 스캔을 위해 카메라 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "이미지 첨부를 위해 사진 권한이 필요합니다."
        }
      ],
      "expo-local-authentication",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false,
          "faceIDPermission": "지갑 잠금 해제를 위해 Face ID 권한이 필요합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ]
  }
}
