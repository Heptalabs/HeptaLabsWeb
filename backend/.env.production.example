NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://prod_user:prod_password@prod-db:5432/imwallet
JWT_SECRET=replace-with-production-secret
JWT_EXPIRES_IN=7d
CORS_ALLOWED_ORIGINS=https://app.imwallet.com,https://console.imwallet.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
CONTENT_ADMIN_REQUIRE_AUTH=true
CONTENT_ADMIN_ALLOW_LEGACY_ROLE_HEADER=false
MARKET_PRICE_PROVIDER=coingecko
MARKET_PRICE_TTL_MS=15000
MARKET_PRICE_TIMEOUT_MS=5000
MARKET_FX_TTL_MS=300000
MARKET_POPULAR_TTL_MS=30000
MARKET_DAPP_PROVIDERS=dappradar,defillama
DAPPRADAR_TOP_DAPPS_ENDPOINT=
DAPPRADAR_BASE_URL=https://apis.dappradar.com
DAPPRADAR_PROJECT_ID=
DAPPRADAR_TOP_DAPPS_PATH=dapps/top/uaw
DAPPRADAR_TOP_RANGE=30d
DAPPRADAR_TOP_LIMIT_PARAM=top
DAPPRADAR_AUTH_HEADER=X-BLOBR-KEY
DAPPRADAR_AUTH_PREFIX=
COINMARKETCAP_API_KEY=
DAPPRADAR_API_KEY=
COINMETRICS_API_KEY=
SOLSCAN_API_KEY=
ETHERSCAN_API_KEY=
TRONSCAN_API_KEY=
DISCOVER_ENFORCE_HTTPS=true
DISCOVER_ALLOWED_URL_HOSTS=coingecko.com,coinmarketcap.com,defillama.com,dune.com,tradingview.com,coindesk.com,aave.com,lido.fi,galxe.com,pancakeswap.finance,uniswap.org,opensea.io
